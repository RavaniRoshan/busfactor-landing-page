# Marketing site environment
# Base URL for the hosted BusFactor app (no trailing slash required)
VITE_APP_URL=https://heir-weld.vercel.app

# PostHog analytics (optional). Leave unset to disable analytics and consent banner.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional consented demo report. When empty, the demo section is hidden.
VITE_DEMO_REPORT_URL=
VITE_DEMO_REPORT_LABEL=
